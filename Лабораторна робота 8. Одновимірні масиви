#include <iostream>

#include <iostream>
using namespace std;

const int n = 30;

int main()
{
    setlocale(LC_CTYPE, "ukr");

    int a[n];
    int i, f1, f2, f3;

    for (i = 0; i < n; i++)
    {
        cout << "Введіть " << i << " елемент масиву: ";
        cin >> a[i];
    }

    cout << "Числа Фібоначчі в масиві:\n";

    for (i = 0; i < n; i++)
    {
        f1 = 0;
        f2 = 1;

        while (f2 <= a[i])
        {
            if (a[i] == 0 || a[i] == 1 || f2 == a[i])
            {
                cout << a[i] << " ";
                break;
            }

            f3 = f1 + f2;
            f1 = f2;
            f2 = f3;
        }
    }

    return 0;
}
