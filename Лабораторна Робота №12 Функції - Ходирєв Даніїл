#include <iostream>
using namespace std;
#include "windows.h"

void sort(int arr[5][5], int n)
{
    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i][n - 1] < arr[j][n - 1])
            {
                int temp = arr[i][n - 1];
                arr[i][n - 1] = arr[j][n - 1];
                arr[j][n - 1] = temp;
            }
        }
    }
}

void main()
{
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    const int n = 5;
    int arr[n][n];

    cout << "Введіть масив:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> arr[i][j];
        }
    }

    int max1 = arr[0][n - 1];
    int max2 = arr[0][n - 1];

    int i1 = 0, j1 = n - 1;
    int i2 = 0, j2 = n - 1;

    for (int i = 0; i < n; i++)
    {
        int j = n - 1 - i;

        if (arr[i][j] > max1)
        {
            max2 = max1;
            i2 = i1;
            j2 = j1;

            max1 = arr[i][j];
            i1 = i;
            j1 = j;
        }
        else if (arr[i][j] > max2 && (i != i1 || j != j1))
        {
            max2 = arr[i][j];
            i2 = i;
            j2 = j;
        }
    }

    int res = (i1 + j1) * (i2 + j2);

    cout << "Результат: " << res << endl;

    sort(arr, n);

    cout << "Після сортування:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }
}
