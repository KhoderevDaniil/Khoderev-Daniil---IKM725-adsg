#include <iostream>
using namespace std;
#include "windows.h"

void main()
{
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    const int n = 20;
    int a[n];
    int b[n];
    int size_b = 0;

    cout << "Введіть 20 елементів масиву a:" << endl;

    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    for (int i = 0; i < n; i++)
    {
        if (a[i] % 2 != 0)
        {
            b[size_b] = a[i];
            size_b++;
        }
    }

    int temp;
    for (int i = 0; i < size_b - 1; i++)
    {
        for (int j = 0; j < size_b - i - 1; j++)
        {
            if (b[j] < b[j + 1])
            {
                temp = b[j];
                b[j] = b[j + 1];
                b[j + 1] = temp;
            }
        }
    }

    cout << "Масив b (непарні елементи у порядку убування):" << endl;

    for (int i = 0; i < size_b; i++)
    {
        cout << b[i] << " ";
    }

    cout << endl;
}
