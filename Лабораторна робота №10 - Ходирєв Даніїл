#include <iostream>
using namespace std;
#include <string>;

struct Processor {
    string Name;
    string Firm;
    float Frequency;
    int Contacts;
};

int main()
{
    int n;

    cout << "Введіть кількість процесорів:" << endl;
    cin >> n;

    Processor* arr = new Processor[n];

    // Ввід
    for (int i = 0; i < n; i++)
    {
        cout << "Назва:" << endl;
        cin >> arr[i].Name;

        cout << "Фірма:" << endl;
        cin >> arr[i].Firm;

        cout << "Частота:" << endl;
        cin >> arr[i].Frequency;

        cout << "Контакти:" << endl;
        cin >> arr[i].Contacts;
    }
    
    cout << "\nСписок:\n";
    for (int i = 0; i < n; i++)
    {
        cout << arr[i].Name << " "
             << arr[i].Firm << " "
             << arr[i].Frequency << " "
             << arr[i].Contacts << endl;
    }
    
    for (int i = 0; i < n; i++)
    {
        if (arr[i].Firm == "AMD")
        {
            arr[i].Name = "Celeron";
        }
    }
    
    cout << "\nПісля зміни:\n";
    for (int i = 0; i < n; i++)
    {
        cout << arr[i].Name << " "
             << arr[i].Firm << " "
             << arr[i].Frequency << " "
             << arr[i].Contacts << endl;
    }

    delete[] arr;
}
