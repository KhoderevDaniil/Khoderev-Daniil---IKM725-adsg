#include <cstddef>
#include <stdexcept>
#include <memory>
#include <iostream>

template <typename T>
class Array {
private:
    T* data;
    size_t n;

public:
    explicit Array(size_t size)
        : data(new T[size]), n(size) {
    }

    ~Array() {
        delete[] data;
    }

    Array(const Array&) = delete;
    Array& operator=(const Array&) = delete;

    T& at(size_t index) {
        if (index >= n) {
            throw std::out_of_range("Index out of range");
        }
        return data[index];
    }

    void set(size_t index, const T& value) {
        if (index >= n) {
            throw std::out_of_range("Index out of range");
        }
        data[index] = value;
    }

    size_t size() const {
        return n;
    }
};
int main() {
    Array<int> arr(3);
    arr.set(0, 10);
    arr.set(1, 20);
    arr.set(2, 30);

    std::cout << arr.at(1);
    return 0;
}
